rules_version = '2';

// audit_logs is written and read exclusively by monolith-api using Application Default
// Credentials, which bypass these rules entirely. Denying everything here closes the
// client SDK path, so a leaked Firebase web config cannot be used to read the audit trail.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
